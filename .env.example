# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values you need.
# Onboarding will append project-specific keys here as the stack is chosen.
# NEVER let the agent read .env — permissions deny it (.claude/settings.json:
# Read(.env) is on the deny list, and a hook blocks cat/grep workarounds).
# ---------------------------------------------------------------------------

# Optional — API key for the context7 documentation MCP server.
# Get one at https://context7.com/dashboard (free tier available).
# The server also works without a key, with tighter rate limits.
CONTEXT7_API_KEY=

# Optional — Supabase project ref, only if Supabase is chosen as the backend
# during onboarding (referenced by the Supabase MCP server URL in .mcp.json).
SUPABASE_PROJECT_REF=
